# Use exactly the hostname or IPv4 address used by ec2/setup.sh.
MQTT_HOST=replace-with-ec2-public-dns
# Single quotes preserve $ and # in a Compose .env value. Avoid ' in this password.
MQTT_PASSWORD='replace-with-instructor-password'
# On the Raspberry Pi, find the stable path with: ls -l /dev/serial/by-id/
ZIGBEE_DEVICE=/dev/serial/by-id/replace-with-your-sonoff-device
